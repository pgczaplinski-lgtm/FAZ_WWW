---
import { navigation } from '../data/site';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
	<div class="container header-inner">
		<a class="brand" href="/" aria-label="Fundacja Aktywności Zawodowej — przejdź na stronę główną">
			<img src="/images/logo-faz.svg" alt="" width="354" height="198" />
		</a>

		<nav class="desktop-nav" aria-label="Główna nawigacja">
			<ul>
				{navigation.map((item) => (
					<li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
				))}
			</ul>
			<a class="button button-primary support-button" href="/wspieram/">Wspieram</a>
		</nav>

		<details class="mobile-menu">
			<summary>Menu</summary>
			<nav aria-label="Nawigacja mobilna">
				<ul>
					{navigation.map((item) => (
						<li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
					))}
					<li><a class="button button-primary" href="/wspieram/">Wspieram</a></li>
				</ul>
			</nav>
		</details>
	</div>
</header>
