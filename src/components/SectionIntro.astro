---
interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
	headingId?: string;
}

const { eyebrow, title, description, headingId } = Astro.props;
---

<div class="section-intro">
	{eyebrow && <p class="eyebrow">{eyebrow}</p>}
	<h2 id={headingId}>{title}</h2>
	{description && <p>{description}</p>}
</div>
