---
import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { activeProjects } from '../../data/site';

const categories: Record<string, string[]> = {
	'osoby': ['Inspiratorium Zawodowe', 'Inspiratorium Kariery III', 'Inspiratorium Współpracy'],
	'instytucje': ['WTZ w dobrych rękach', 'Dostęp do wiedzy III'],
	'dostepnosc': ['Dyrektywa EAA', 'Dostęp do wiedzy III'],
};
---

<BaseLayout title="Projekty — Fundacja Aktywności Zawodowej" description="Aktywne projekty FAZ dla osób z niepełnosprawnościami, WTZ, instytucji i firm.">
	<section class="section">
		<div class="container">
			<nav aria-label="Okruszki"><a href="/">Strona główna</a> <span aria-hidden="true">/</span> Projekty</nav>
			<div class="section-intro">
				<p class="eyebrow">Działamy teraz</p>
				<h1>Aktywne projekty</h1>
				<p>Wybierz obszar, aby zawęzić listę. Jeśli nie wiesz, który projekt odpowiada Twojej sytuacji, skontaktuj się z zespołem.</p>
			</div>

			<fieldset class="filters" id="project-filters">
				<legend>Filtruj projekty według obszaru</legend>
				<label><input type="checkbox" value="osoby" /> Wsparcie osób</label>
				<label><input type="checkbox" value="instytucje" /> WTZ i instytucje</label>
				<label><input type="checkbox" value="dostepnosc" /> Dostępność</label>
			</fieldset>
			<p id="filter-status" class="status" aria-live="polite">Wyświetlono 6 projektów.</p>

			<div class="project-grid" id="project-list">
				{activeProjects.map((project) => {
					const projectCategories = Object.entries(categories).filter(([, titles]) => titles.includes(project.title)).map(([key]) => key);
					return <div data-categories={projectCategories.join(' ')}><ProjectCard project={project} /></div>;
				})}
			</div>

			<section class="archive" aria-labelledby="archive-title">
				<h2 id="archive-title">Projekty zakończone</h2>
				<p>Archiwum wymaga uporządkowania i sprawdzenia materiałów z poprzedniej strony. Informacje o zakończonych działaniach można otrzymać bezpośrednio od Fundacji.</p>
				<a class="text-link" href="/kontakt/">Zapytaj o zakończony projekt</a>
			</section>
		</div>
	</section>

	<script>
		const fieldset = document.querySelector('#project-filters');
		const items = [...document.querySelectorAll<HTMLElement>('#project-list > [data-categories]')];
		const status = document.querySelector('#filter-status');
		fieldset?.addEventListener('change', () => {
			const selected = [...fieldset.querySelectorAll<HTMLInputElement>('input:checked')].map((input) => input.value);
			let visible = 0;
			for (const item of items) {
				const matches = selected.length === 0 || selected.some((value) => item.dataset.categories?.split(' ').includes(value));
				item.hidden = !matches;
				if (matches) visible += 1;
			}
			if (status) status.textContent = visible === 1 ? 'Wyświetlono 1 projekt.' : `Wyświetlono ${visible} projektów.`;
		});
	</script>
</BaseLayout>

<style>
	.filters { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; margin-bottom: 1rem; padding: 1.25rem; border: 1px solid var(--color-line); border-radius: var(--radius-sm); }
	.filters legend { padding-inline: .4rem; font-weight: 800; }
	.filters label { display: inline-flex; min-height: 2.75rem; align-items: center; gap: .55rem; font-weight: 700; }
	.filters input { width: 1.25rem; height: 1.25rem; }
	.status { margin-bottom: 1.5rem; color: var(--color-muted); }
	.archive { max-width: 48rem; margin-top: 4rem; padding-top: 2rem; border-top: 2px solid var(--color-line); }
	.archive p { margin-block: 1rem; }
</style>
