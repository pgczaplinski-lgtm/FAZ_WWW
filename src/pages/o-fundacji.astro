---
import BaseLayout from '../layouts/BaseLayout.astro';
import { stats, teamLeadership } from '../data/site';

const impactStats = stats.slice(1, 4);
const timeline = [
	{ year: '2008', event: 'Powstaje Fundacja Aktywności Zawodowej.' },
	{ year: '2011', event: 'Fundacja uzyskuje status organizacji pożytku publicznego.' },
	{ year: '2019', event: 'Powstaje Inspiratorium Kariery.' },
	{ year: '2022', event: 'Fundacja tworzy Instytut Aktywności Zawodowej.' },
	{ year: '2024', event: 'Rozpoczyna się Inspiratorium Zawodowe.' },
];
---

<BaseLayout
	title="O Fundacji Aktywności Zawodowej"
	description="Poznaj misję, metodę, historię i osoby kierujące Fundacją Aktywności Zawodowej, która działa na rzecz osób z niepełnosprawnościami od 2008 roku."
	image="/images/zespol-faz.jpg"
>
	<div class="container page-top">
		<nav class="breadcrumb" aria-label="Okruszki">
			<a href="/">Strona główna</a><span aria-hidden="true">/</span><span aria-current="page">O Fundacji</span>
		</nav>
	</div>

	<section class="detail-hero">
		<div class="container hero-grid">
			<div>
				<p class="eyebrow">Fundacja Aktywności Zawodowej</p>
				<h1>Od 2008 roku budujemy drogi do aktywności zawodowej</h1>
				<p class="hero-intro">Skupiamy się na osobach z niepełnosprawnościami i na otoczeniu, które wpływa na ich możliwość pracy: rodzinach, WTZ, instytucjach i pracodawcach.</p>
			</div>
			<figure>
				<img src="/images/zespol-faz.jpg" alt="Zespół Fundacji Aktywności Zawodowej podczas wspólnego spotkania" width="1152" height="864" />
				<figcaption>Zespół Fundacji łączy doświadczenie trenerskie, doradcze, społeczne i prawne.</figcaption>
			</figure>
		</div>
	</section>

	<section class="section mission-section" aria-labelledby="mission-title">
		<div class="container mission-grid">
			<div>
				<p class="eyebrow">Misja i metoda</p>
				<h2 id="mission-title">Możliwości stają się widoczne w działaniu</h2>
			</div>
			<div>
				<p>Naszą misją jest tworzenie warunków, w których osoba z niepełnosprawnością może poznać własne zasoby, rozwijać odpowiedzialność i budować trwałą tożsamość zawodową.</p>
				<p>Pracujemy przez realne zadania, diagnozę funkcjonalną, małe osiągalne sukcesy oraz informację zwrotną w języku zawodowym. Łączymy indywidualną pracę z człowiekiem ze zmianą sposobu działania instytucji i pracodawców.</p>
				<a class="text-link" href="/jak-dzialamy/">Poznaj metodę FAZ</a>
			</div>
		</div>
	</section>

	<section class="section impact-section" aria-labelledby="impact-title">
		<div class="container">
			<div class="section-intro">
				<p class="eyebrow">Wpływ działań</p>
				<h2 id="impact-title">Doświadczenie mierzone praktyką</h2>
				<p>Dane własne Fundacji pokazują skalę dotychczasowych działań. Są opisem pracy FAZ, a nie audytem zewnętrznym.</p>
			</div>
			<dl class="impact-grid">
				{impactStats.map((stat) => (
					<div>
						<dt>{stat.label}</dt>
						<dd>{stat.value}</dd>
					</div>
				))}
			</dl>
		</div>
	</section>

	<section class="section leadership-section" aria-labelledby="leadership-title">
		<div class="container">
			<div class="section-intro">
				<p class="eyebrow">Kierownictwo Fundacji</p>
				<h2 id="leadership-title">Osoby odpowiedzialne za rozwój FAZ</h2>
				<p>Fundacją kierują praktycy związani z aktywizacją zawodową, szkoleniami i sektorem społecznym.</p>
			</div>
			<ul class="leadership-list">
				{teamLeadership.map((leader) => (
					<li>
						<h3>{leader.name}</h3>
						<p class="role">{leader.role}</p>
						<p>{leader.expertise}</p>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section timeline-section" aria-labelledby="timeline-title">
		<div class="container timeline-grid">
			<div>
				<p class="eyebrow">Najważniejsze momenty</p>
				<h2 id="timeline-title">Historia rozwoju Fundacji</h2>
			</div>
			<ol>
				{timeline.map((item) => (
					<li>
						<time datetime={item.year}>{item.year}</time>
						<p>{item.event}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="section information-section" aria-labelledby="information-title">
		<div class="container information-grid">
			<div>
				<p class="eyebrow">Przejrzystość i kontakt</p>
				<h2 id="information-title">Sprawdź dokumenty albo porozmawiaj z nami</h2>
				<p>Informacje o działalności i sprawozdania Fundacji są dostępne w jednym miejscu. W sprawie działań, projektów lub współpracy zapraszamy do bezpośredniego kontaktu.</p>
			</div>
			<div class="resource-links">
				<a class="button button-secondary" href="/o-fundacji/sprawozdania/">Zobacz sprawozdania Fundacji</a>
				<a class="text-link" href="/kontakt/">Przejdź do kontaktu</a>
			</div>
		</div>
	</section>

	<section class="contact-band" aria-labelledby="cta-title">
		<div class="container contact-band-grid">
			<div>
				<p class="eyebrow">Siedziba w Gdańsku</p>
				<h2 id="cta-title">Skontaktuj się z zespołem Fundacji</h2>
				<p>ul. Romana Dmowskiego 12/3.12, 80-264 Gdańsk<br />Biuro jest dostępne w dni robocze od 8:00 do 16:00.</p>
			</div>
			<div class="contact-actions">
				<a class="button button-primary" href="/kontakt/">Wszystkie dane kontaktowe</a>
				<p><a href="mailto:biuro@faz.org.pl">biuro@faz.org.pl</a><br /><a href="tel:+48736858551">736 858 551</a></p>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.page-top { padding-top: 1.25rem; }
	.breadcrumb { display: flex; flex-wrap: wrap; gap: .45rem .7rem; align-items: center; color: var(--color-muted); font-size: .9rem; }
	.detail-hero { padding-block: clamp(2.5rem, 7vw, 6.5rem); }
	.hero-grid, .mission-grid, .timeline-grid, .information-grid { display: grid; gap: 2.5rem clamp(2rem, 8vw, 7rem); align-items: center; }
	.hero-intro { max-width: 48rem; margin-top: 1.5rem; color: var(--color-muted); font-size: clamp(1.12rem, 2vw, 1.4rem); }
	.hero-grid figure img { width: 100%; aspect-ratio: 4 / 3; border-radius: var(--radius-lg) var(--radius-sm) var(--radius-lg) var(--radius-sm); box-shadow: var(--shadow); object-fit: cover; }
	.hero-grid figcaption { margin-top: .8rem; color: var(--color-muted); font-size: .9rem; }
	.mission-section { background: var(--color-blue-pale); }
	.mission-grid > div:last-child { max-width: 48rem; }
	.mission-grid > div:last-child p + p { margin-top: 1.15rem; }
	.mission-grid .text-link { margin-top: 1rem; }
	.impact-section { background: var(--color-navy); color: white; }
	.impact-section .eyebrow, .impact-section h2 { color: white; }
	.impact-section .section-intro > p:last-child { color: #e1e6ef; }
	.impact-grid { display: grid; gap: 1px; background: rgb(255 255 255 / .25); }
	.impact-grid > div { display: flex; padding: 1.4rem; flex-direction: column-reverse; background: var(--color-navy); }
	.impact-grid dt { color: #e1e6ef; }
	.impact-grid dd { margin-bottom: .4rem; font-size: clamp(2rem, 5vw, 3.4rem); font-weight: 800; line-height: 1; }
	.leadership-section { background: var(--color-white); }
	.leadership-list { display: grid; gap: 1rem; list-style: none; }
	.leadership-list li { padding: 1.5rem; border-top: 4px solid var(--color-blue); background: var(--color-paper); }
	.leadership-list .role { margin-top: .65rem; color: var(--color-blue-dark); font-weight: 750; }
	.leadership-list p:last-child { margin-top: .45rem; color: var(--color-muted); }
	.timeline-section { background: var(--color-green-pale); }
	.timeline-section ol { list-style: none; }
	.timeline-section li { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: 1rem; padding-block: 1rem; border-top: 1px solid #bdccbf; }
	.timeline-section li:last-child { border-bottom: 1px solid #bdccbf; }
	.timeline-section time { color: var(--color-blue-dark); font-weight: 850; }
	.information-section { background: var(--color-paper); }
	.information-grid > div:first-child > p:last-child { max-width: 44rem; margin-top: 1rem; color: var(--color-muted); }
	@media (min-width: 48rem) {
		.hero-grid { grid-template-columns: minmax(0, 1.05fr) minmax(22rem, .95fr); }
		.mission-grid, .timeline-grid, .information-grid { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); }
		.impact-grid, .leadership-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	}
</style>
